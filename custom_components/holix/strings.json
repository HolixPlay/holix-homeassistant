          "music_video": "Music video",
          "live_tv": "Live TV",
          "audio": "Audio",
          "video": "Video",
          "other": "Other"
        }
      },
      "dynamic_range": {
        "name": "Dynamic range",
        "state": {
          "none": "None",
          "sdr": "SDR",
          "hdr10": "HDR10",
          "hdr10_plus": "HDR10+",
          "dolby_vision": "Dolby Vision",
          "hlg": "HLG"
        }
      },
      "segment": {
        "name": "Segment",
        "state": {
          "none": "None",
          "intro": "Intro",
