  "services": {
    "show_notification": {
      "name": "Show notification",
      "description": "Shows a message on the Holix Play screen without stopping playback.",
      "fields": {
        "message": {
          "name": "Message",
          "description": "Text to show."
        },
        "title": {
          "name": "Title",
          "description": "Optional heading."
        },
        "duration": {
          "name": "Duration",
          "description": "Seconds on screen (1–60)."
        }
      }
    }
  }
