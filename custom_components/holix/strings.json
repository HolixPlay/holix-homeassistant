        "name": "Screensaver"
      }
    },
    "select": {
      "profile_select": {
        "name": "Profile"
      }
    },
    "light": {
      "ambilight": {
        "name": "Ambilight"
      }
    },
    "remote": {
      "remote": {
        "name": "Navigation"
      }
    },
    "event": {
      "playback_event": {
        "name": "Playback",
        "state_attributes": {
          "event_type": {
            "state": {
              "playback_started": "Playback started",
              "playback_paused": "Playback paused",
              "playback_resumed": "Playback resumed",
              "playback_stopped": "Playback stopped",
              "segment_started": "Segment started",
              "segment_ended": "Segment ended",
